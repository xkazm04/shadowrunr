{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shadowrunr Console",
  "version": "0.1.0",
  "identifier": "dev.shadowrunr.console",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shadowrunr Console",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' http://127.0.0.1:7717; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:7717 ws://127.0.0.1:7717"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
