{
  "name": "@shadowrunr/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0 && stylelint \"src/**/*.css\" && node scripts/check-size.mjs && node scripts/check-token-refs.mjs",
    "budget:bundle": "node scripts/check-bundle.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@shadowrunr/contract": "workspace:*",
    "@shadowrunr/tokens": "workspace:*",
    "@tanstack/react-virtual": "3.14.21",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
